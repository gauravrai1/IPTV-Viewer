# ── Xtream Codes credentials ──────────────────────────────────────────────────
XTREAM_URL=http://your-provider.example.com:8080
XTREAM_USERNAME=your_username
XTREAM_PASSWORD=your_password

# ── Host paths bind-mounted into the containers ───────────────────────────────
# These must be absolute paths on the Docker host (your NAS / homelab server).
# They default to ./downloads/movies and ./downloads/shows if left unset.
MOVIES_HOST_PATH=/mnt/media/movies
SHOWS_HOST_PATH=/mnt/media/tvshows

# ── Web UI port ───────────────────────────────────────────────────────────────
PORT=8080

# ── User/group the container runs as ──────────────────────────────────────────
# Match the PUID/PGID your other media containers (Radarr, Sonarr, Jellyfin,
# etc.) use, so downloaded files are owned consistently across the stack.
IPTV_PUID=1000
IPTV_PGID=1000
